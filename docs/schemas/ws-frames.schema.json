{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahub.bobocai.win/schemas/ws-frames.schema.json",
  "title": "WebSocketFrame",
  "description": "Discriminated union of all JSON frames exchanged over /ws/node and /ws/stream.",
  "$defs": {
    "DeliveriesSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "sent", "queued", "failed"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "sent": { "type": "integer", "minimum": 0 },
        "queued": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 }
      }
    },
    "NativeEventView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "node_id",
        "event_id",
        "agent",
        "event_kind",
        "native_session_id",
        "workdir",
        "title",
        "summary",
        "source",
        "notify_key_id",
        "notify_status",
        "notify_error",
        "ack_at",
        "attention_state",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^evt_[A-Za-z0-9]+$" },
        "node_id": { "type": "string", "minLength": 1 },
        "event_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "agent": { "type": "string", "enum": ["agy", "pi", "omp", "codex", "claude", "grok"] },
        "event_kind": { "type": "string", "enum": ["interaction_needed", "turn_summary", "progress"] },
        "native_session_id": { "type": "string" },
        "workdir": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "source": { "type": "string" },
        "notify_key_id": { "type": ["string", "null"] },
        "notify_status": { "type": "string", "enum": ["none", "queued", "sent", "partial", "failed", "skipped"] },
        "notify_error": { "type": "string" },
        "ack_at": { "type": ["string", "null"], "format": "date-time" },
        "attention_state": { "type": ["string", "null"], "enum": ["open", "acked", "superseded", "stale", null] },
        "deliveries_summary": { "$ref": "#/$defs/DeliveriesSummary" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "NotificationDeliveryRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_kind",
        "source_id",
        "trigger_event",
        "node_id",
        "channel_kind",
        "channel_id",
        "channel_label",
        "target_host",
        "route_mode",
        "status",
        "attempts",
        "http_status",
        "error_code",
        "error_message",
        "sent_at",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^dlv_[A-Za-z0-9]+$" },
        "source_kind": { "type": "string", "enum": ["run", "native_event", "board_message"] },
        "source_id": { "type": "string", "pattern": "^(run|evt|msg)_[A-Za-z0-9]+$" },
        "trigger_event": {
          "type": "string",
          "enum": [
            "needs_approval",
            "done",
            "failed",
            "cancelled",
            "interaction_needed",
            "turn_summary",
            "progress",
            "question_opened"
          ]
        },
        "node_id": { "type": "string", "minLength": 1 },
        "channel_kind": { "type": "string", "enum": ["bot_webhook", "web_push", "legacy_webhook"] },
        "channel_id": { "type": "string", "minLength": 1 },
        "channel_label": { "type": "string" },
        "target_host": { "type": "string" },
        "route_mode": { "type": "string", "enum": ["key", "node_default", "web_push", "global_legacy"] },
        "status": { "type": "string", "enum": ["queued", "sent", "failed", "skipped"] },
        "attempts": { "type": "integer", "minimum": 0 },
        "http_status": { "type": ["integer", "null"], "minimum": 100, "maximum": 599 },
        "error_code": { "type": "string" },
        "error_message": { "type": "string" },
        "sent_at": { "type": ["string", "null"], "format": "date-time" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "BoardHandoffSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "actor_profile", "source_node", "text_md", "data", "created_at"],
      "properties": {
        "id": { "type": "string", "pattern": "^msg_[A-Za-z0-9]+$" },
        "actor_profile": { "type": "string", "maxLength": 40, "pattern": "^(|[a-z0-9][a-z0-9._@-]{0,39})$" },
        "source_node": { "type": "string", "maxLength": 64, "pattern": "^(|[a-z0-9][a-z0-9_-]*)$" },
        "text_md": { "type": "string", "maxLength": 8192 },
        "data": { "type": "object" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "BoardTopic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "channel",
        "title",
        "external_ref",
        "status",
        "previous_status",
        "pinned",
        "sort_order",
        "labels",
        "created_by_key_id",
        "last_message_id",
        "last_handoff_message_id",
        "last_event_cursor",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^top_[A-Za-z0-9]+$" },
        "channel": { "type": "string", "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "external_ref": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "enum": ["todo", "in_progress", "blocked", "done", "archived"] },
        "previous_status": { "type": "string", "enum": ["", "todo", "in_progress"] },
        "pinned": { "type": "boolean" },
        "sort_order": { "type": "number" },
        "labels": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": { "type": "string", "minLength": 1, "maxLength": 64 },
          "additionalProperties": { "type": "string", "maxLength": 128 }
        },
        "created_by_key_id": { "type": ["string", "null"], "pattern": "^key_[A-Za-z0-9]+$" },
        "last_message_id": { "type": "string", "pattern": "^(|msg_[A-Za-z0-9]+)$" },
        "last_handoff_message_id": { "type": "string", "pattern": "^(|msg_[A-Za-z0-9]+)$" },
        "last_event_cursor": { "type": "integer", "minimum": 0 },
        "open_question_count": { "type": "integer", "minimum": 0 },
        "message_count": { "type": "integer", "minimum": 0 },
        "latest_handoff": {
          "oneOf": [
            { "$ref": "#/$defs/BoardHandoffSnapshot" },
            { "type": "null" }
          ]
        },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "BoardMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "topic_id",
        "channel",
        "seq",
        "kind",
        "reply_to_id",
        "actor_scope",
        "actor_key_id",
        "actor_profile",
        "source_node",
        "text_md",
        "data",
        "question_state",
        "question_options",
        "question_expires_at",
        "answered_message_id",
        "answered_at",
        "created_at"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^msg_[A-Za-z0-9]+$" },
        "topic_id": { "type": "string", "pattern": "^top_[A-Za-z0-9]+$" },
        "channel": { "type": "string", "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$" },
        "seq": { "type": "integer", "minimum": 1 },
        "kind": { "type": "string", "enum": ["note", "handoff", "question", "answer", "artifact"] },
        "reply_to_id": { "type": ["string", "null"], "pattern": "^msg_[A-Za-z0-9]+$" },
        "actor_scope": { "type": "string", "enum": ["admin", "client"] },
        "actor_key_id": { "type": ["string", "null"], "pattern": "^key_[A-Za-z0-9]+$" },
        "actor_profile": { "type": "string", "maxLength": 40, "pattern": "^(|[a-z0-9][a-z0-9._@-]{0,39})$" },
        "source_node": { "type": "string", "maxLength": 64, "pattern": "^(|[a-z0-9][a-z0-9_-]*)$" },
        "text_md": { "type": "string", "maxLength": 8192 },
        "data": { "type": "object" },
        "question_state": { "type": "string", "enum": ["", "open", "answered", "expired", "cancelled"] },
        "question_options": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "question_expires_at": { "type": ["string", "null"], "format": "date-time" },
        "answered_message_id": { "type": ["string", "null"], "pattern": "^msg_[A-Za-z0-9]+$" },
        "answered_at": { "type": ["string", "null"], "format": "date-time" },
        "deliveries_summary": { "$ref": "#/$defs/DeliveriesSummary" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "conn_nonce", "version", "os", "arch", "max_concurrency", "capabilities", "workspaces"],
      "properties": {
        "type": { "const": "node.hello" },
        "conn_nonce": { "type": "string", "minLength": 8 },
        "version": { "type": "string" },
        "os": { "type": "string" },
        "arch": { "type": "string" },
        "max_concurrency": { "type": "integer", "minimum": 1, "maximum": 16 },
        "capabilities": {
          "type": "object",
          "properties": {
            "agents": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "enabled": { "type": "boolean" },
                  "available": { "type": "boolean" },
                  "default_model": { "type": "string", "maxLength": 128 },
                  "default_effort": {
                    "type": "string",
                    "enum": ["", "off", "minimal", "low", "medium", "high", "xhigh", "max", "ultra", "auto"]
                  },
                  "catalog_status": {
                    "type": "string",
                    "enum": ["pending", "ready", "fallback"]
                  },
                  "models": {
                    "type": "array",
                    "maxItems": 500,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["id", "label", "efforts"],
                      "properties": {
                        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
                        "label": { "type": "string", "maxLength": 160 },
                        "efforts": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "enum": ["off", "minimal", "low", "medium", "high", "xhigh", "max", "ultra", "auto"]
                          }
                        },
                        "default_effort": {
                          "type": "string",
                          "enum": ["", "off", "minimal", "low", "medium", "high", "xhigh", "max", "ultra", "auto"]
                        }
                      }
                    }
                  }
                }
              }
            },
            "aliases": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        },
        "workspaces": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "path"],
            "properties": {
              "key": { "type": "string" },
              "path": { "type": "string" },
              "default_branch": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "active_run_ids", "ts"],
      "properties": {
        "type": { "const": "node.ping" },
        "active_run_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "ts": { "type": "string", "format": "date-time" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "run_id", "seq", "kind", "payload", "ts"],
      "properties": {
        "type": { "const": "run.event" },
        "run_id": { "type": "string", "pattern": "^run_[A-Za-z0-9]+$" },
        "seq": { "type": "integer", "minimum": 1 },
        "kind": {
          "type": "string",
          "enum": ["status", "tool_use", "turn_end", "approval_needed", "stderr_warn", "system"]
        },
        "payload": { "type": "object" },
        "ts": { "type": "string", "format": "date-time" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "run_id", "events"],
      "properties": {
        "type": { "const": "run.events" },
        "run_id": { "type": "string", "pattern": "^run_[A-Za-z0-9]+$" },
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["seq", "kind", "payload", "ts"],
            "properties": {
              "seq": { "type": "integer", "minimum": 1 },
              "kind": {
                "type": "string",
                "enum": ["status", "tool_use", "turn_end", "approval_needed", "stderr_warn", "system"]
              },
              "payload": { "type": "object" },
              "ts": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "run_id", "lease_owner", "status", "ts"],
      "properties": {
        "type": { "const": "run.state" },
        "run_id": { "type": "string", "pattern": "^run_[A-Za-z0-9]+$" },
        "lease_owner": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["running", "needs_approval", "done", "failed", "cancelled"]
        },
        "remote_control_url": { "type": "string" },
        "resolved_model": { "type": "string" },
        "resolved_effort": { "type": "string" },
        "ts": { "type": "string", "format": "date-time" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "node_id", "heartbeat_interval_ms", "has_pending_runs"],
      "properties": {
        "type": { "const": "hub.welcome" },
        "node_id": { "type": "string" },
        "heartbeat_interval_ms": { "type": "integer", "minimum": 5000 },
        "has_pending_runs": { "type": "boolean" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "reason"],
      "properties": {
        "type": { "const": "hub.wake" },
        "reason": { "type": "string", "enum": ["run_queued", "reconcile"] },
        "run_id": { "type": "string" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "run_id", "reason"],
      "properties": {
        "type": { "const": "hub.abort" },
        "run_id": { "type": "string", "pattern": "^run_[A-Za-z0-9]+$" },
        "reason": { "type": "string" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "nodes", "ts"],
      "properties": {
        "type": { "const": "snapshot" },
        "nodes": { "type": "array", "items": { "type": "object" } },
        "threads": { "type": "array", "items": { "type": "object" } },
        "runs": { "type": "array", "items": { "type": "object" } },
        "native_events": {
          "type": "array",
          "items": { "$ref": "#/$defs/NativeEventView" }
        },
        "open_interaction_count": { "type": "integer", "minimum": 0 },
        "open_board_question_count": { "type": "integer", "minimum": 0 },
        "topic": { "$ref": "#/$defs/BoardTopic" },
        "ts": { "type": "string", "format": "date-time" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "node"],
      "properties": {
        "type": { "const": "node.status" },
        "node": { "type": "object" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "run"],
      "properties": {
        "type": { "const": "run.updated" },
        "run": { "type": "object" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "code", "message"],
      "properties": {
        "type": { "const": "error" },
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "event", "open_interaction_count"],
      "properties": {
        "type": { "const": "native_event.upserted" },
        "event": { "$ref": "#/$defs/NativeEventView" },
        "open_interaction_count": { "type": "integer", "minimum": 0 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "delivery"],
      "properties": {
        "type": { "const": "delivery.updated" },
        "delivery": { "$ref": "#/$defs/NotificationDeliveryRecord" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "topic"],
      "properties": {
        "type": { "const": "board.topic_updated" },
        "topic": { "$ref": "#/$defs/BoardTopic" },
        "cursor": { "type": "integer", "minimum": 1 },
        "open_board_question_count": { "type": "integer", "minimum": 0 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "message", "cursor"],
      "properties": {
        "type": { "const": "board.message_created" },
        "message": { "$ref": "#/$defs/BoardMessage" },
        "topic": { "$ref": "#/$defs/BoardTopic" },
        "cursor": { "type": "integer", "minimum": 1 },
        "open_board_question_count": { "type": "integer", "minimum": 0 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "question", "answer", "cursor"],
      "properties": {
        "type": { "const": "board.question_answered" },
        "question": { "$ref": "#/$defs/BoardMessage" },
        "answer": { "$ref": "#/$defs/BoardMessage" },
        "topic": { "$ref": "#/$defs/BoardTopic" },
        "cursor": { "type": "integer", "minimum": 1 },
        "open_board_question_count": { "type": "integer", "minimum": 0 }
      }
    }
  ]
}
