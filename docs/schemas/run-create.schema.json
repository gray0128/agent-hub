{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahub.bobocai.win/schemas/run-create.schema.json",
  "title": "CreateRunRequest",
  "description": "Request payload for POST /api/v1/runs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["prompt"],
  "properties": {
    "thread_id": {
      "type": "string",
      "pattern": "^thr_[A-Za-z0-9]+$",
      "description": "Existing thread ID to continue. When set, node_id, workdir, and agent default to the thread's bound target."
    },
    "node_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "description": "Target execution node identifier. Required when thread_id is omitted."
    },
    "workdir": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Project short key (e.g. dds) or absolute path on the target node. Required when thread_id is omitted."
    },
    "agent": {
      "type": "string",
      "enum": ["agy", "pi", "omp", "codex", "claude"],
      "description": "Local agent adapter to execute the prompt."
    },
    "model": {
      "type": "string",
      "maxLength": 128,
      "description": "Model alias (e.g. carbon, ds-pro) or provider/model identifier."
    },
    "effort": {
      "type": "string",
      "enum": ["", "off", "minimal", "low", "medium", "high", "xhigh", "max", "ultra", "auto"],
      "description": "Reasoning or thinking effort level."
    },
    "sandbox": {
      "type": "boolean",
      "default": true,
      "description": "Whether sandbox mode is enabled when supported by the target agent."
    },
    "timeout_sec": {
      "type": "integer",
      "minimum": 10,
      "maximum": 7200,
      "default": 900,
      "description": "Execution timeout in seconds."
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200000,
      "description": "Task instructions passed to the target agent."
    },
    "title": {
      "type": "string",
      "maxLength": 160,
      "description": "Optional thread title when creating a new thread."
    },
    "parent_run_id": {
      "type": "string",
      "pattern": "^run_[A-Za-z0-9]+$",
      "description": "Parent run ID injected from AHUB_RUN_ID for lineage and recursion checks."
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "description": "Client-provided deduplication key."
    },
    "depends_on": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^run_[A-Za-z0-9]+$"
      },
      "description": "Optional upstream run IDs that must reach 'done' before this run becomes 'queued'."
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time",
      "description": "Optional UTC RFC 3339 timestamp (+60s to +7d) before which the run remains 'waiting'."
    },
    "board_topic_id": {
      "type": "string",
      "pattern": "^top_[A-Za-z0-9]+$",
      "description": "Optional coordination board topic ID for automatic terminal handoff writeback."
    },
    "actor_profile": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[a-z0-9][a-z0-9._@-]{0,39}$",
      "description": "Optional caller profile attribution."
    },
    "labels": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-z0-9][a-z0-9._/-]{0,63}$",
        "not": { "pattern": "^ahub\\." }
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 128,
        "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
      },
      "description": "Optional user-defined run labels (max 16 pairs; ahub.* prefix reserved for control plane)."
    },
    "result_schema": {
      "type": "object",
      "description": "Optional inline JSON Schema (<= 16 KB serialized, bounded Draft 2020-12 subset) validating structured output written to AHUB_RESULT_FILE."
    },
    "notify": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": {
          "type": "string",
          "enum": ["none", "grok", "webhook"],
          "default": "none"
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["done", "failed", "cancelled", "needs_approval"]
          },
          "uniqueItems": true
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "not": {
          "required": ["thread_id"]
        }
      },
      "then": {
        "required": ["node_id", "workdir", "agent"]
      }
    }
  ]
}
